# Copy to .env and fill in. Everything is optional: without a key Nabd runs
# on its local core engine and still detects, diagnoses and recovers known faults.

# LLM deep path. Nabd reads its own NABD_LLM_* names so a shell that exports
# ANTHROPIC_* for another tool cannot redirect your key.
NABD_LLM_API_KEY=
# Leave empty for Claude. For DeepSeek:
#   NABD_LLM_BASE_URL=https://api.deepseek.com/anthropic
#   NABD_MODEL=deepseek-v4-pro
NABD_LLM_BASE_URL=
NABD_MODEL=claude-opus-5-5
NABD_EFFORT=medium

# Optional: per-million-token prices for a model Nabd doesn't know, so the War Room can show cost.
# NABD_PRICE_IN=
# NABD_PRICE_OUT=
